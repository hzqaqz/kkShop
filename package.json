{
  "name": "kkshop-h5-official-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/make-google-feed.mjs --optional && vite-ssg build && node scripts/clean-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "sync:policies": "node --env-file=.env scripts/sync-policies.mjs",
    "feed:google": "node scripts/make-google-feed.mjs",
    "check:checkout": "node scripts/check-checkout-url.mjs",
    "images:optimize": "node scripts/optimize-images.mjs && node scripts/inject-image-dimensions.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "@vitejs/plugin-vue": "^5.2.1",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.0",
    "vite": "^6.0.3",
    "vite-ssg": "^28.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "rollup": "npm:@rollup/wasm-node@^4.60.4"
  }
}
