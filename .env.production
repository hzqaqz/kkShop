# ─────────────────────────────────────────────────────────────
# 生产构建配置（会提交到仓库）
#
# 为什么这个文件要被提交？因为 `VITE_*` 变量是在 **构建时** 内联进 JS 产物的。
# 之前只有被 .gitignore 忽略的 .env，所以 Cloudflare Pages 从 GitHub 构建时拿不到
# 这两个变量，线上产物里域名/token 都是空字符串 —— 结果就是产品页没有 Add to cart、
# 导航栏的购物车按钮消失、首页的 Add to cart 点了没反应。
#
# 这里的 Storefront 令牌是「公共访问令牌（public token）」：Shopify 明确允许它
# 出现在浏览器端代码里（它只能读商品、建购物车，无法访问后台）。而且它本来就会
# 出现在网站的 JS bundle 里，所以放在仓库里并不额外增加暴露面。
# 如需轮换：Shopify 后台 → Headless → Storefront API → 重新生成公共令牌。
#
# Cloudflare Pages 上如果也设置了同名环境变量，以面板里的为准（优先级更高）。
# ─────────────────────────────────────────────────────────────

VITE_SHOPIFY_STORE_DOMAIN=meowerair.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=f4fc6acce94c019bbab4e7fdfa8f1f1c

# 库存/价格按市场计算；不填则默认 NZ。
VITE_SHOPIFY_COUNTRY=NZ
