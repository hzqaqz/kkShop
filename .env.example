# ─────────────────────────────────────────────────────────────
# Shopify Storefront (headless) configuration
# Copy this file to `.env` and fill in the two values below.
# The Storefront access token is PUBLIC by design — it can read
# products and manage carts, but cannot touch your admin.
# ─────────────────────────────────────────────────────────────

# 1) Your store domain, e.g. `my-store.myshopify.com`
#    Found in Shopify admin → Settings → Domains.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# 2) Storefront API 的「公共访问令牌」(Public access token)。
#    获取：在线商店 → Headless 渠道 → 店面 → Storefront API → 凭据 → 公共访问令牌。
#    ⚠️ 用「公共」令牌（客户端用）；不要用「私有访问令牌」(shpat_…，仅服务器端，切勿放前端)。
VITE_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) 店面「市场（Market）」国家代码，默认 NZ。
#    商品库存/可用性是按市场计算的：如果某个市场的库存为 0，
#    即使商品能读出来，加入购物车也会被 Shopify 拒绝（MERCHANDISE_OUT_OF_STOCK）。
VITE_SHOPIFY_COUNTRY=NZ
