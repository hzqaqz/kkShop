# ─────────────────────────────────────────────────────────────
# Shopify Storefront (headless) configuration
# Copy this file to `.env` and fill in the two values below.
# The Storefront access token is PUBLIC by design — it can read
# products and manage carts, but cannot touch your admin.
# ─────────────────────────────────────────────────────────────

# 1) Your store domain, e.g. `my-store.myshopify.com`
#    Found in Shopify admin → Settings → Domains.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# 2) Storefront API 的「公共访问令牌」(Public access token)。
#    获取：在线商店 → Headless 渠道 → 店面 → Storefront API → 凭据 → 公共访问令牌。
#    ⚠️ 用「公共」令牌（客户端用）；不要用「私有访问令牌」(shpat_…，仅服务器端，切勿放前端)。
VITE_SHOPIFY_STOREFRONT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) 店面「市场（Market）」国家代码，默认 NZ。
#    商品库存/可用性是按市场计算的：如果某个市场的库存为 0，
#    即使商品能读出来，加入购物车也会被 Shopify 拒绝（MERCHANDISE_OUT_OF_STOCK）。
VITE_SHOPIFY_COUNTRY=NZ

# ─────────────────────────────────────────────────────────────
# 流量统计（可选，不填 = 完全不上报）
# 用无 cookie 的方案，所以不需要 cookie 同意弹窗，隐私政策也不用改口径。
# 改完要在 Cloudflare Pages 重新部署才会生效（VITE_* 是构建期内联的）。
# ─────────────────────────────────────────────────────────────

# 4) `plausible` 或 `umami`；留空/`none` 表示关闭。
VITE_ANALYTICS_PROVIDER=none

# 5) Plausible：填注册的域名即可（自建则额外填 PLAUSIBLE_SCRIPT）。
VITE_PLAUSIBLE_DOMAIN=meowerair.com
# VITE_PLAUSIBLE_SCRIPT=https://stats.example.com/js/script.js

# 6) Umami：填实例地址和网站 ID。
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Shopify Inbox 在线客服（可选，不填 = 不加载任何聊天脚本）
#
# 官方开关是主题里的 App embed（Online store chat），只在 Liquid 主题里存在；
# 本站是自建 Vue 站，所以由 components/ShopifyInboxChat.vue 直接加载 Shopify
# 那个公开的 storefront chat loader。需要两个值：
#   - 门店域名：复用上面的 VITE_SHOPIFY_STORE_DOMAIN
#   - Inbox shop id：店铺数字 ID（也能在主题源码里 trekkie 的 shopId 找到）
# 注意：Shopify 的机器人防护会屏蔽 localhost，只有部署到正式/预览域名才会显示。
# ─────────────────────────────────────────────────────────────

# VITE_SHOPIFY_INBOX_SHOP_ID=84321272034
